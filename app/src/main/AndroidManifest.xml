<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shake-to-report posts the issue to GitHub. Nothing else here is online: the ring is read
         over Bluetooth and the data never leaves the phone. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Talking to the ring. On Android 12 and up these two are the whole of it, and
      `neverForLocation` is the honest declaration: this app scans for one service UUID belonging
      to a ring on the user's own finger, and has no interest in where that is.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      Android 11 and below have no scan permission of their own: a BLE scan is a location signal
      as far as that platform is concerned, so the location permission is what a scan needs there.
      Capped with maxSdkVersion so a modern phone is never asked for a location this app cannot use.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!--
      The companion-device flow, which is the only pairing dialog this phone will draw: the app
      asks, the *system* runs the picker, and the picker comes back as an IntentSender the app
      launches — an activity rather than a notification. The watch profile is what makes the
      platform take on the pairing itself. Both are ordinary permissions; the dialog is the consent.
      See ble/Companion.kt.
    -->
    <uses-permission android:name="android.permission.REQUEST_COMPANION_PROFILE_WATCH" />
    <uses-feature android:name="android.software.companion_device_setup" android:required="false" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BrightOura">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:theme="@style/Theme.BrightOura">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
          The last way in on a phone that never draws a pairing request: the notification carries a
          Pair action, its PendingIntent runs as the system that created it, and pressing it needs
          none of the permissions confirming a pairing normally does. Switched on with one adb line,
          the same shape BrightControl uses for its lock face:

            adb shell cmd notification allow_listener com.gios.brightoura/.notify.PairingListener

          Reads only Bluetooth pairing notifications, presses only buttons whose words mean yes.
          See notify/PairingListener.kt.
        -->
        <service
            android:name=".notify.PairingListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
